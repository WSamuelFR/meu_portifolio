# ==============================================================================
# ARCHITECTURE SPECIFICATION & PRODUCTION HTACCESS CONFIGURATION
# Portfolio & Interactive Platform — Wesley Samuel Ferreira Rodrigues
# Optimized for High Performance, InfinityFree & Static Web Hosts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Base e Codificação de Caracteres
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# Desativa a listagem de arquivos e diretórios por segurança
Options -Indexes

# ------------------------------------------------------------------------------
# 2. Cabeçalhos de Segurança (Security Headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Previne ataques de clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Bloqueia farejamento de MIME Types (MIME-sniffing)
    Header set X-Content-Type-Options "nosniff"
    
    # Habilita filtro XSS nos navegadores compatíveis
    Header set X-XSS-Protection "1; mode=block"
    
    # Proteção de Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloqueia acesso direto a arquivos ocultos (.git, .env, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. Compressão Gzip / Deflate (Otimização de Carregamento)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/eot
</IfModule>

# ------------------------------------------------------------------------------
# 4. Cache do Navegador (Expires Headers & Caching Strategy)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (Sem cache longo para garantir atualizações do portfólio)
    ExpiresByType text/html "access plus 1 hour"

    # CSS e JavaScript (Cache de 1 Mês)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Imagens e Mídias Estáticas (Cache de 1 Ano)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Vídeos (Cache de 1 Ano)
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Documentos PDF (Cache de 1 Mês)
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Tratamento de Erros Semânticos (Custom Error Documents)
# ------------------------------------------------------------------------------
ErrorDocument 404 /index.html
